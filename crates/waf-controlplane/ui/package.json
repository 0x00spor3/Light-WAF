{
  "name": "waf-controlplane-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Web dashboard for the Light WAF control plane (§7). Consumes the read API.",
  "license": "BUSL-1.1",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "e2e:server": "cargo build --release -p waf-controlplane --features embed-ui --manifest-path ../../../Cargo.toml",
    "e2e": "npm run build && npm run e2e:server && playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.13.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
