# syntax=docker/dockerfile:1
# ─────────────────────────────────────────────────────────────────────────────
# waf-enterprise — the WAF data-plane binary (enterprise tier, BSL 1.1).
#
# Build context = the detached `enterprise/` workspace (it depends on the core by
# crates.io VERSION, so no OPEN source is needed):
#
#   docker build -f Dockerfile.enterprise -t waf-enterprise:latest .
#
# Run it with your config mounted (secrets — CF_API_TOKEN, AWS_*, WAF_REDIS_URL —
# come from the environment, never the image):
#
#   docker run --rm -p 8080:8080 \
#     -v "$PWD/config.toml:/etc/waf/config.toml:ro" \
#     -e WAF_REDIS_URL=redis://redis:6379 \
#     waf-enterprise:latest
# ─────────────────────────────────────────────────────────────────────────────

# ── Build stage ──────────────────────────────────────────────────────────────
FROM rust:1-bookworm AS build

# `waf-enterprise` links the AWS SDK (Route 53 DNS-01), which pulls `aws-lc-rs` —
# that crate's build needs cmake + a C toolchain (build-essential/perl already ship
# in the rust:bookworm base). ca-certificates lets cargo fetch from crates.io.
RUN apt-get update \
    && apt-get install -y --no-install-recommends cmake ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY . .

# Build the release binary. `--locked` uses the committed Cargo.lock for a
# reproducible dependency graph. Cache mounts speed up re-builds; because the
# cached target/ is not part of the image layer, copy the binary out in the same
# RUN to a plain path the runtime stage can pick up.
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/build/target \
    cargo build --release --locked -p waf-enterprise \
    && cp /build/target/release/waf-enterprise /usr/local/bin/waf-enterprise

# ── Runtime stage ────────────────────────────────────────────────────────────
FROM debian:bookworm-slim AS runtime

# ca-certificates: outbound TLS (ACME directory, HTTPS threat-intel feeds, backends).
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 10001 --home /app --shell /usr/sbin/nologin waf \
    && mkdir -p /etc/waf /app \
    && chown -R waf:waf /etc/waf /app

COPY --from=build /usr/local/bin/waf-enterprise /usr/local/bin/waf-enterprise

USER waf
WORKDIR /app

# The sample config listens on 0.0.0.0:8080 (plain h1/h2c). If you enable TLS
# termination it serves on the configured port instead (443 needs a published
# mapping and, if bound directly, NET_BIND_SERVICE — prefer a mapped high port).
EXPOSE 8080

# The enterprise binary reuses the core's config resolver, which takes `--config <path>`
# (or the WAF_CONFIG env var) — NOT a bare positional. Mount your config at this path.
ENTRYPOINT ["waf-enterprise"]
CMD ["--config", "/etc/waf/config.toml"]
