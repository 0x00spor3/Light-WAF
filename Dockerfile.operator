# syntax=docker/dockerfile:1
# ─────────────────────────────────────────────────────────────────────────────
# waf-operator — Kubernetes operator that reconciles WafProxy CRs into data-plane
# Deployments (K4). It has NO inbound port (a controller/client).
#
#   docker build -f Dockerfile.operator -t waf-operator:latest .
# ─────────────────────────────────────────────────────────────────────────────

# ── Build stage ──────────────────────────────────────────────────────────────
FROM rust:1-bookworm@sha256:9181b56c2a21ab1d5e73cffe04fc762426d30aa7fac3c91141dd033f49a7fc8b AS build

# kube-client uses rustls+ring (no aws-lc-rs), so the base toolchain plus
# ca-certificates for the crates.io fetch is enough — no cmake.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY . .

RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/build/target \
    cargo build --release --locked -p waf-operator \
    && cp /build/target/release/waf-operator /usr/local/bin/waf-operator \
    && mkdir -p /skel/app

# ── Runtime stage ────────────────────────────────────────────────────────────
# Distroless (cc = glibc + libgcc + libssl3 + the CA bundle) — the operator is a
# controller/client dynamically linked against glibc only (kube-client uses
# rustls+ring). No apt/shell needed; this drops the whole Debian base-OS CVE
# surface `debian:bookworm-slim` carried. Pinned by digest.
FROM gcr.io/distroless/cc-debian12@sha256:e8e7ee4b8b106d4c5fde9e422a321b2b8a2d5cca546c97adcce927f3e1d36e36 AS runtime

ARG VERSION=0.0.0-dev
ARG VCS_REF=unknown
ARG BUILD_DATE=unknown
LABEL org.opencontainers.image.title="waf-operator" \
      org.opencontainers.image.description="Light WAF Kubernetes operator for the WafProxy custom resource" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.source="https://github.com/0x00spor3/Light-WAF" \
      org.opencontainers.image.vendor="Light WAF"

# CA bundle for TLS to the Kubernetes API server ships with distroless at
# /etc/ssl/certs/ca-certificates.crt — no install needed.
COPY --from=build --chown=10001:10001 /skel/app /app
COPY --from=build /usr/local/bin/waf-operator /usr/local/bin/waf-operator

# Non-root, numeric (no passwd entry needed; matches the uid the charts pin).
USER 10001:10001
WORKDIR /app

# Default entrypoint runs the controller; `waf-operator crd` prints the CRD manifest.
ENTRYPOINT ["/usr/local/bin/waf-operator"]
