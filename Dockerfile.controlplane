# syntax=docker/dockerfile:1
# ─────────────────────────────────────────────────────────────────────────────
# waf-controlplane — dashboard/API over the OPEN telemetry (§7).
#
# Built as a SINGLE binary with the web UI embedded (`--features embed-ui`): a Node
# stage produces `ui/dist`, which rust-embed bakes into the binary at compile time.
#
# Build context = the repository root (the whole workspace):
#
#   docker build -f Dockerfile.controlplane -t waf-controlplane:latest .
#
#   docker run --rm -p 9600:9600 \
#     -v "$PWD/controlplane.toml:/etc/waf/controlplane.toml:ro" \
#     -e WAF_CP_DATABASE_URL=postgres://waf:waf@postgres:5432/waf_cp \
#     -e WAF_CP_API_TOKEN=... \
#     waf-controlplane:latest
#
# IMPORTANT: in the config set `listen = "0.0.0.0:9600"` (the sample binds 127.0.0.1,
# which is unreachable from outside the container). Postgres is required at startup.
# ─────────────────────────────────────────────────────────────────────────────

# ── UI stage: build the SPA bundle (ui/dist) ─────────────────────────────────
FROM node:22-bookworm-slim AS ui

WORKDIR /ui
# Install deps first (cached until the lockfile changes). `npm ci` includes the
# devDeps that `npm run build` (tsc + vite) needs.
COPY crates/waf-controlplane/ui/package.json crates/waf-controlplane/ui/package-lock.json ./
RUN npm ci
COPY crates/waf-controlplane/ui/ ./
RUN npm run build   # → /ui/dist

# ── Build stage: compile the control plane with the UI embedded ──────────────
FROM rust:1-bookworm AS build

# Control plane uses rustls+ring only (no aws-lc-rs / cmake): base toolchain +
# ca-certificates for the crates.io fetch is enough.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY . .
# rust-embed reads `ui/dist` (relative to the crate) at compile time — drop the
# freshly built bundle where `#[folder = "ui/dist"]` expects it.
COPY --from=ui /ui/dist crates/waf-controlplane/ui/dist

RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/build/target \
    cargo build --release --locked -p waf-controlplane --features embed-ui \
    && cp /build/target/release/waf-controlplane /usr/local/bin/waf-controlplane \
    && mkdir -p /skel/app

# ── Runtime stage ────────────────────────────────────────────────────────────
# Distroless (cc = glibc + libgcc + libssl3 + the CA bundle). The binary is
# dynamically linked against glibc only (rustls+ring; the Postgres driver is the
# pure-Rust sqlx-postgres — no libpq/libssl). Dropping the debian base ALSO removes
# curl (previously present only for the Docker HEALTHCHECK), and with it the whole
# curl/libcurl4/libssh2/libldap CVE cluster. Pinned by digest.
FROM gcr.io/distroless/cc-debian12@sha256:e8e7ee4b8b106d4c5fde9e422a321b2b8a2d5cca546c97adcce927f3e1d36e36 AS runtime

ARG VERSION=0.0.0-dev
ARG VCS_REF=unknown
ARG BUILD_DATE=unknown
LABEL org.opencontainers.image.title="waf-controlplane" \
      org.opencontainers.image.description="Light WAF control plane: telemetry, dashboard, API and governance" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.source="https://github.com/0x00spor3/Light-WAF" \
      org.opencontainers.image.vendor="Light WAF"

# CA bundle for outbound TLS (OIDC IdP, https /metrics scrape, alert webhooks) ships
# with distroless at /etc/ssl/certs/ca-certificates.crt — no install needed.
COPY --from=build --chown=10001:10001 /skel/app /app
COPY --from=build /usr/local/bin/waf-controlplane /usr/local/bin/waf-controlplane

# Non-root, numeric (no passwd entry needed; matches the uid the charts pin).
USER 10001:10001
WORKDIR /app

EXPOSE 9600

# No Docker HEALTHCHECK: distroless has no curl/shell. Liveness/readiness is done by
# the Kubernetes httpGet probes against `/healthz` (public, no auth) defined in the
# chart; for `docker run`, probe http://<host>:9600/healthz from outside the container.

# Config path is argv[1] (or `controlplane.toml`); mount yours at this path. The
# database URL is best provided via WAF_CP_DATABASE_URL rather than the file.
ENTRYPOINT ["/usr/local/bin/waf-controlplane"]
CMD ["/etc/waf/controlplane.toml"]
